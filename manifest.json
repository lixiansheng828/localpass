{
    "manifest_version": 3,
    "name": "LocalPass",
    "version": "2.0.0",
    "description": "本地密码管理器 - 无需云端，完全加密存储",
    "author": "LocalPass Team",
    "permissions": [
        "storage",
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "LocalPass - 密码管理器"
    },
    "options_ui": {
        "page": "settings.html",
        "open_in_tab": false
    },
    "minimum_chrome_version": "88"
}